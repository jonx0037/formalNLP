---
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
// Same katex package rehype-katex renders with, so the CSS can't drift from the HTML.
// Vite self-hosts its fonts. Imported before global.css so the overrides there win.
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { PRELAUNCH } from '../lib/siteConfig';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'The mathematics of language',
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Link previews need an absolute image URL.
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {PRELAUNCH && <meta name="robots" content="noindex, nofollow" />}

    <title>{title} | formalNLP</title>
    <meta name="description" content={description} />

    <!-- OG -->
    <meta property="og:title" content={`${title} | formalNLP`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="formalNLP" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] font-[family-name:var(--font-serif)]">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Pagefind search dialog -->
    <div id="search-dialog" class="hidden fixed inset-0 z-50 bg-black/50 flex items-start justify-center pt-20">
      <div class="bg-[var(--color-surface)] rounded-xl shadow-xl w-full max-w-xl mx-6 p-6">
        <div id="search"></div>
      </div>
    </div>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
          new PagefindUI({ element: '#search', showSubResults: true });
        }
        document.getElementById('search-trigger')?.addEventListener('click', () => {
          document.getElementById('search-dialog')?.classList.toggle('hidden');
        });
        document.getElementById('search-dialog')?.addEventListener('click', (e) => {
          if (e.target === e.currentTarget) {
            e.currentTarget.classList.add('hidden');
          }
        });
      });
    </script>
  </body>
</html>
